{
  "name": "@adonisjs/lucid",
  "description": "SQL ORM built on top of Active Record pattern",
  "version": "21.4.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "precompile": "npm run lint",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "quick:test": "DB=sqlite NODE_DEBUG=adonisjs:lucid node --import=ts-node-maintained/register/esm --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/env": "^6.1.1",
    "@adonisjs/eslint-config": "^2.0.0-beta.6",
    "@adonisjs/prettier-config": "^1.4.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/assert": "^4.0.1",
    "@japa/expect": "^3.0.3",
    "@japa/expect-type": "^2.0.3",
    "@japa/file-system": "^2.3.2",
    "@japa/runner": "^4.2.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@swc/core": "^1.10.9",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.11.11",
    "better-sqlite3": "^11.8.1",
    "c8": "^10.1.3",
    "eslint": "^9.19.0",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "release-it": "^18.1.2",
    "tedious": "^18.6.1",
    "ts-node-maintained": "^10.9.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@poppinss/exception": "^1.2.0",
    "knex": "^3.1.0",
    "knex-dynamic-connection": "^3.2.0",
    "tarn": "3.0.2"
  },
  "homepage": "https://github.com/adonisjs/lucid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/lucid.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/lucid/issues"
  },
  "keywords": [
    "sql",
    "pg",
    "mysql",
    "sqlite",
    "lucid",
    "adonisjs",
    "knex"
  ],
  "author": "Harminder Virk <virk@adonisjs.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsup": {
    "entry": [
      "index.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
